                      <SUB-CONTAINERS>
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:05970121-ec17-4bb9-85ed-ef627532028d">
                          <SHORT-NAME>OsPhysicalCore</SHORT-NAME>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>255</UPPER-MULTIPLICITY>
                          <MULTIPLICITY-CONFIG-CLASSES>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          </MULTIPLICITY-CONFIG-CLASSES>
                          <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                          <REQUIRES-INDEX>false</REQUIRES-INDEX>
                          <PARAMETERS>
                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:c2607708-1f8a-447d-99c0-4d6f2a46516e">
                              <SHORT-NAME>OsPhysicalCoreId</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This parameter defines the physical Id of the core.</L-2>
                                <L-2 L="ZH">概述：OsPhysicalCoreId定义多核系统中物理核心的标识号，用于操作系统对多核处理器的资源管理</L-2>
                                <L-2 L="ZH">注意：物理核心ID必须与硬件实际核心数量匹配，且在多核系统中保持唯一性。</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>LOCAL</SCOPE>
                              <MULTIPLICITY-CONFIG-CLASSES>
                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              </MULTIPLICITY-CONFIG-CLASSES>
                              <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <REQUIRES-INDEX>false</REQUIRES-INDEX>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>0</DEFAULT-VALUE>
                              <MAX>255</MAX>
                              <MIN>0</MIN>
                            </ECUC-INTEGER-PARAM-DEF>
                          </PARAMETERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:7287d34c-73d0-4585-b436-eb460bd4a186">
                          <SHORT-NAME>OsHardWareTimer</SHORT-NAME>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>255</UPPER-MULTIPLICITY>
                          <MULTIPLICITY-CONFIG-CLASSES>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          </MULTIPLICITY-CONFIG-CLASSES>
                          <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                          <REQUIRES-INDEX>false</REQUIRES-INDEX>
                          <PARAMETERS>
                            <ECUC-STRING-PARAM-DEF UUID="ECUC:31c43c42-e673-4ccf-b641-d16d964fdb7b">
                              <SHORT-NAME>OsHardWareTimerChannel</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This attribute specifies the macro definition of the timer channel.</L-2>
                                <L-2 L="ZH">概述：OsHardWareTimerClockFrequency 是一个配置项，用于指定操作系统硬件定时器的时钟频率，这个参数对于系统定时器的准确性和分辨率至关重要。</L-2>
                                <L-2 L="ZH">注意：必须确保此配置项的值与实际硬件定时器的时钟频率相匹配；不正确的配置可能导致操作系统定时功能不准确；在多核或多时钟系统中，还需考虑不同硬件定时器之间的时钟频率差异。</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Os_00026</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>LOCAL</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <ECUC-STRING-PARAM-DEF-VARIANTS>
                                <ECUC-STRING-PARAM-DEF-CONDITIONAL>
                                  <MAX-LENGTH>63</MAX-LENGTH>
                                  <MIN-LENGTH>1</MIN-LENGTH>
                                </ECUC-STRING-PARAM-DEF-CONDITIONAL>
                              </ECUC-STRING-PARAM-DEF-VARIANTS>
                            </ECUC-STRING-PARAM-DEF>
                            <ECUC-FLOAT-PARAM-DEF UUID="ECUC:cb1a5e46-66bb-4572-8a2e-c19c49531452">
                              <SHORT-NAME>OsHardWareTimerClockFrequency</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Timer clock frequency, MHZ.</L-2>
                                <L-2 L="ZH">概述：OsHardWareTimer配置项用于定义操作系统(OS)中使用的硬件定时器，包括定时器的属性和行为，以便于操作系统能够管理时间和调度任务。</L-2>
                                <L-2 L="ZH">注意：在配置OsHardWareTimer时，需要确保所选定时器与硬件平台兼容，并且满足操作系统的时钟和定时需求；应当注意定时器的分辨率和最大计数值，以确保可以支持所需的定时精度和最大定时周期；在多核系统中，还需考虑定时器是否支持跨核使用或者每个核心是否需要独立的硬件定时器。</L-2>
                              </DESC>
                              <ADMIN-DATA>
                                <SDGS>
                                  <SDG GID="VCOS:Display">
                                    <SD GID="VCOS:BaseUnit">MHZ</SD>
                                  </SDG>
                                </SDGS>
                              </ADMIN-DATA>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Os_00030</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>ECU</SCOPE>
                              <MULTIPLICITY-CONFIG-CLASSES>
                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              </MULTIPLICITY-CONFIG-CLASSES>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <MAX INTERVAL-TYPE="CLOSED">Inf</MAX>
                              <MIN INTERVAL-TYPE="CLOSED">0</MIN>
                            </ECUC-FLOAT-PARAM-DEF>
                          </PARAMETERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:f0a82f84-2640-47e9-8c97-5aacbe5e0a90">
                          <SHORT-NAME>OsMemoryRegionSpecifics</SHORT-NAME>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <MULTIPLICITY-CONFIG-CLASSES>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          </MULTIPLICITY-CONFIG-CLASSES>
                          <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                          <REQUIRES-INDEX>false</REQUIRES-INDEX>
                          <SUB-CONTAINERS>
                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="cb5be6c7-1854-4801-ab95-f7e7de565bc1">
                              <SHORT-NAME>OsMemoryRegionAccess</SHORT-NAME>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                              <MULTIPLICITY-CONFIG-CLASSES>
                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              </MULTIPLICITY-CONFIG-CLASSES>
                              <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                              <REQUIRES-INDEX>false</REQUIRES-INDEX>
                              <PARAMETERS>
                                <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:ab69a342-93ef-4895-aaae-ffac44bc0d94">
                                  <SHORT-NAME>OsMemoryRegionAccessRights</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Defines the access rights for a memory protection region.NONE: No access rights.R: Read access rights.W: Write access rights.X: Execution access rights</L-2>
                                    <L-2 L="ZH">概述：OsMemoryRegionAccess配置项用于定义操作系统内存区域的访问权限，确保特定的软件组件或模块能够访问指定的内存区域，同时保护内存区域不被未授权访问。</L-2>
                                    <L-2 L="ZH">注意：在配置OsMemoryRegionAccess时，需要确保正确匹配内存区域与访问权限，避免潜在的安全风险；AUTOSAR CP 4.4标准中对内存保护和访问控制有详细规定，需要遵守这些规定以确保系统的安全性；配置不当可能导致系统运行异常或安全漏洞。</L-2>
                                  </DESC>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <REQUIRES-INDEX>false</REQUIRES-INDEX>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>NONE</DEFAULT-VALUE>
                                  <LITERALS>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:815925a4-bbbe-4c98-96a7-302f0f66054e">
                                      <SHORT-NAME>USER_NON_SUPERVISOR_R</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:eb1be813-aac1-40e5-942d-046861920286">
                                      <SHORT-NAME>USER_NON_SUPERVISOR_RW</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:1343a1a2-15c6-4e8f-b6c5-67b6fa2b3f05">
                                      <SHORT-NAME>USER_NON_SUPERVISOR_RX</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:4b143ca1-064b-4991-8097-3871cca4d0f1">
                                      <SHORT-NAME>USER_R_SUPERVISOR_R</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:8729ad67-8648-4389-899e-4112c0f7549a">
                                      <SHORT-NAME>USER_RW_SUPERVISOR_RW</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:08cdcb98-f9c3-4d01-851f-59b589273fb5">
                                      <SHORT-NAME>USER_RX_SUPERVISOR_RX</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:fb521aed-4b6e-4404-a9a4-b54998edb388">
                                      <SHORT-NAME>USER_X_SUPERVISOR_X</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                  </LITERALS>
                                </ECUC-ENUMERATION-PARAM-DEF>
                              </PARAMETERS>
                            </ECUC-PARAM-CONF-CONTAINER-DEF>
                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:fca88b80-e881-4cfd-836b-ffec2e820069">
                              <SHORT-NAME>OsMemoryRegionFlags</SHORT-NAME>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                              <MULTIPLICITY-CONFIG-CLASSES>
                                <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              </MULTIPLICITY-CONFIG-CLASSES>
                              <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                              <REQUIRES-INDEX>false</REQUIRES-INDEX>
                              <PARAMETERS>
                                <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:a8df1e40-c94c-4dcb-a73c-70152eb0567b">
                                  <SHORT-NAME>OsMemoryRegionMemoryAttributes</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Defines the memory attributes for a memory protection region.</L-2>
                                    <L-2 L="ZH">概述：OsMemoryRegionMemoryAttributes配置项用于定义操作系统内存区域的内存属性，确保特定的区域有特定的属性。</L-2>
                                    <L-2 L="ZH">注意：在配置OsMemoryRegionMemoryAttributes时，需要确保正确匹配内存区域与内存属性，避免潜在的安全风险。</L-2>
                                  </DESC>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <REQUIRES-INDEX>false</REQUIRES-INDEX>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>NONE</DEFAULT-VALUE>
                                  <LITERALS>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:bbfbf87d-2d53-4f8f-951c-f77d85674a4e">
                                      <SHORT-NAME>MEMATTR_TYPE_00_WRITE_BACK_WRTIE_ALLOCATE_CACHEABLE</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:4f5689f9-ecc3-4fc0-97e5-1563a950ddf9">
                                      <SHORT-NAME>MEMATTR_TYPE_01_WRITE_THROUGH_CACHEABLE</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:7edbf3b1-4f01-4d4f-9495-36aeb5d527ad">
                                      <SHORT-NAME>MEMATTR_TYPE_02_NO_CACHEABLE</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:5d0ec78c-9ce0-48d6-bb29-4c649da29e75">
                                      <SHORT-NAME>MEMATTR_TYPE_03_DEVICE_NGNRNE</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:3d7ff0f0-1ebd-458f-aa1f-f0ba39c4998f">
                                      <SHORT-NAME>MEMATTR_TYPE_04_DEVICE_NGNRE</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                  </LITERALS>
                                </ECUC-ENUMERATION-PARAM-DEF>
                              </PARAMETERS>
                            </ECUC-PARAM-CONF-CONTAINER-DEF>
                          </SUB-CONTAINERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                      </SUB-CONTAINERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                  </SUB-CONTAINERS>
                </ECUC-PARAM-CONF-CONTAINER-DEF>
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:037fee7c-9826-4ab9-9067-69b24b57fe12">
                  <SHORT-NAME>OsOS</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">OS is the object used to define ISO 17356-3 properties for an ISO 17356 application.</L-2>
                    <L-2 L="ZH">概述：OsOS 是 AUTOSAR OS模块的主配置容器，包含操作系统的全局属性，如安全级别等。</L-2>
                    <L-2 L="ZH">注意：在配置OsOS时，必须确保所有参数符合AUTOSAR CP 4.4标准的要求；配置应考虑系统的实时性和资源限制；正确配置OsOS对系统稳定性和性能至关重要。</L-2>
                  </DESC>
                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Os_00044</RELATED-TRACE-ITEM-REF>
                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <PARAMETERS>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:a4c62701-41c5-417c-8b66-16c90d6d111f">
                      <SHORT-NAME>OsScalabilityClass</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">A scalability class for each System Object "OS" has to be selected. In order to customize the operating system to the needs of the user and to take full advantage of the processor features the operating system can be scaled according to the scalability classes.</L-2>
                        <L-2 L="ZH">概述：OsScalabilityClass 定义了操作系统的安全级别，这影响了操作系统的功能和性能特性。</L-2>
                        <L-2 L="ZH">注意：选择合适的OsScalabilityClass对于系统资源的优化和性能提升至关重要，但也同样关系着系统的安全级别。</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Os_00259</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>ECU</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <LITERALS>
                        <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:ce27c590-e408-98ea-42a2-bc1746a0c2cb">
                          <SHORT-NAME>SC1</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:070246b2-500e-8def-4157-ade4cbb0c048">
                          <SHORT-NAME>SC2</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:38bafefe-a5d1-9974-2581-505f9bc27e21">
                          <SHORT-NAME>SC3</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:09b92f6c-de62-970b-3305-226efbeff18e">
                          <SHORT-NAME>SC4</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                  </PARAMETERS>
                  <SUB-CONTAINERS>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:e03dab8e-c227-44c9-bf9b-38f0564bd4df">
                      <SHORT-NAME>OsHooks</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Container to structure all hooks belonging to the OS</L-2>
                        <L-2 L="ZH">概述：OsHooks 配置项用于定义操作系统钩子函数，这些钩子函数在操作系统的特定点被调用，以实现自定义的行为，例如在任务切换或系统错误时执行特定操作。</L-2>
                        <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，需要确保钩子函数的使用不会违反操作系统的实时性和可预测性；钩子函数应当简短且执行时间可控，以避免对系统调度造成不必要的影响；正确配置钩子函数的启用和禁用，以满足系统安全和性能要求。</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Os_00035</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <PARAMETERS>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:67f9db57-53e9-4e0e-8e47-23cc534733b5">
                          <SHORT-NAME>OsPostTaskHook</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Post-task hook as defined by ISO 17356</L-2>
                            <L-2 L="ZH">概述：OsPostTaskHook配置项用于指定操作系统在每个任务执行完毕后调用的钩子函数，这可以用于执行任务级别的清理工作或状态检查。</L-2>
                            <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，确保OsPostTaskHook的使用不会引入过多的运行时开销，从而影响系统性能；此外，钩子函数中应避免执行可能导致任务阻塞的操作；最后，钩子函数应该是可重入的，以支持多任务环境下的安全执行。</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="ZH">错误: 禁用任务完毕后调用的钩子函数</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Os_00037</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>true</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:fbfe7932-0338-461a-b87d-58af3a85bbcb">
                          <SHORT-NAME>OsPreTaskHook</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Pre-task hook as defined by ISO 17356</L-2>
                            <L-2 L="ZH">概述：OsPreTaskHook 是一个操作系统配置参数，用于启用或禁用任务执行前的钩子函数，这可以用于执行特定的预处理操作。</L-2>
                            <L-2 L="ZH">注意：在AUTOSAR CP 4.4中，确保在使用OsPreTaskHook时考虑系统的实时性和性能影响；此配置应与OsPostTaskHook配合使用以保持系统行为的一致性；过多使用钩子可能会导致系统开销增加，影响整体性能。</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="ZH">错误: 禁用任务执行前钩子函数</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Os_00043</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>true</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:12fdd5b3-a654-4c22-a3e1-d9d0906515ad">
                          <SHORT-NAME>OsPanicHook</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Panic-task hook as defined by ISO 17356</L-2>
                            <L-2 L="ZH">概述：OsPanicHook是一个操作系统配置参数，用于定义当操作系统检测到严重错误（如违反OS内部逻辑或硬件错误）时是否调用Panic Hook函数。</L-2>
                            <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，应确保OsPanicHook的配置与系统的错误处理策略一致；如果启用了Panic Hook，需要提供相应的Hook函数实现；在资源受限的系统中，使用Panic Hook可能会增加额外的资源消耗。</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="ZH">错误: 禁用Panic Hook</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Os_00038</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>true</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:825a1254-49f2-4f16-aa94-d9eedd045480">
                          <SHORT-NAME>OsErrorHook</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Error hook as defined by ISO 17356</L-2>
                            <L-2 L="ZH">概述：OsErrorHook配置项用于定义操作系统是否启用错误钩子（Error Hook），这是一个操作系统服务，当操作系统检测到错误时会调用该钩子函数。</L-2>
                            <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，启用OsErrorHook可能会影响系统的性能，因为每次操作系统错误时都会调用该钩子；此外，需要确保Error Hook的实现不会引入新的错误，避免错误处理过程中的递归调用；最后，应当仔细考虑Error Hook对系统内存和时间行为的影响。</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="ZH">错误: 禁用错误钩子</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Os_00036</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>true</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:2c8a2ea4-a437-4c3b-98d9-f76dacf7cb43">
                          <SHORT-NAME>OsErrorHookStackSize</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">The size of a ErrorHook stack is defined by the value of this attribute.</L-2>
                            <L-2 L="ZH">概述：OsErrorHookStackSize配置项定义了操作系统错误钩子（Error Hook）函数使用的栈大小，确保有足够的栈空间来处理操作系统级别的错误。</L-2>
                            <L-2 L="ZH">注意：栈大小需根据错误处理代码的复杂度合理配置，避免栈溢出；在多任务系统中，应考虑各任务对栈的共享和影响；AUTOSAR CP 4.4标准中未明确指定默认栈大小，需根据实际应用需求和硬件资源配置。</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Os_00090</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>1024</DEFAULT-VALUE>
                          <MAX>65535</MAX>
                          <MIN>128</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:bafbef31-9d83-4b29-b534-300490f20f1f">
                          <SHORT-NAME>OsProtectionHook</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Switch to enable/disable the call to the (user supplied) protection hook.</L-2>
                            <L-2 L="ZH">概述：OsProtectionHook配置项用于定义操作系统保护钩子函数，该函数在操作系统检测到严重错误（如内存访问违规、时间违规等）时被调用，用于执行错误处理或系统恢复。</L-2>
                            <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，确保OsProtectionHook仅用于处理不可恢复的错误；配置时需注意其对系统响应时间的影响；保护钩子的实现必须遵循AUTOSAR的错误处理规范。</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="ZH">错误: 禁用保护钩子</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Os_00214</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>ECU</SCOPE>
                          <MULTIPLICITY-CONFIG-CLASSES>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          </MULTIPLICITY-CONFIG-CLASSES>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>true</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:f746ae3b-90ec-470e-88a3-058f25ef1790">
                          <SHORT-NAME>OsProtectionHookStackSize</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">The size of a ProtectionHook stack is defined by the value of this attribute.</L-2>
                            <L-2 L="ZH">概述：OsProtectionHookStackSize 配置项用于定义操作系统保护钩子（Protection Hook）的栈大小，这是一个用于错误处理和系统监控的回调函数，当操作系统检测到严重错误时会调用。</L-2>
                            <L-2 L="ZH">注意：栈大小必须足够以支持保护钩子函数内的所有操作，包括局部变量、函数调用和可能的上下文切换；过小的栈可能导致栈溢出，而过大的栈则会浪费宝贵的系统资源；在配置栈大小时，应考虑目标硬件的内存限制和操作系统的具体实现。</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Os_00092</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>1024</DEFAULT-VALUE>
                          <MAX>65535</MAX>
                          <MIN>128</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:69032d37-2751-420e-9b13-75625e8f3e9f">
                          <SHORT-NAME>OsShutdownHook</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Shutdown hook as defined by ISO 17356</L-2>
                            <L-2 L="ZH">概述：OsShutdownHook是一个操作系统配置参数，用于指定系统关闭时是否调用ShutdownHook回调函数，以执行特定的关闭操作。</L-2>
                            <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，需要确保如果启用OsShutdownHook，相应的回调函数应当被正确实现；此外，应当注意ShutdownHook的执行时间不应过长，以避免延迟系统关闭过程；最后，需要考虑ShutdownHook的调用可能与系统的安全需求相关联，因此应当遵循相关的功能安全要求（如ASIL等级）。</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="ZH">错误: 禁用Shutdown Hook</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Os_00039</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>true</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:f8a27a59-714a-46f0-a166-4787af4870aa">
                          <SHORT-NAME>OsShutdownHookStackSize</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">The size of a ShutdownHook stack is defined by the value of this attribute.</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Os_00093</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>1024</DEFAULT-VALUE>
                          <MAX>65535</MAX>
                          <MIN>128</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:591b0fc5-9552-4b15-99d8-74b85ac249bd">
                          <SHORT-NAME>OsStartupHook</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Startup hook as defined by ISO 17356</L-2>
                            <L-2 L="ZH">概述：OsStartupHook配置项用于定义操作系统启动时是否调用Startup Hook函数，这是一个在操作系统启动完成后，任何任务或中断服务例程被调度之前执行的钩子函数。</L-2>
                            <L-2 L="ZH">注意：在使用OsStartupHook时，需要确保操作系统配置支持钩子函数的使用；此外，过多的逻辑处理在Startup Hook中可能会影响系统启动性能；AUTOSAR标准要求此配置项应谨慎使用，以避免影响系统的实时性和可预测性。</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="ZH">错误: 禁用Startup Hook</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Os_00040</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>true</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:97afce32-3d8a-40cd-b3df-ddf8b4e60f42">
                          <SHORT-NAME>OsStartupHookStackSize</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">The size of a StartupHook stack is defined by the value of this attribute.</L-2>
                            <L-2 L="ZH">概述：OsStartupHookStackSize配置项用于定义操作系统启动钩子（Startup Hook）的栈大小，确保有足够的栈空间执行启动时的启动初始化代码。</L-2>
                            <L-2 L="ZH">注意：栈大小需根据启动钩子中的代码复杂度合理设置，避免栈溢出；AUTOSAR CP 4.4标准中未明确指定默认栈大小，需根据具体实现和硬件条件确定；过大的栈大小可能会浪费系统资源。</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Os_00094</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>1024</DEFAULT-VALUE>
                          <MAX>65535</MAX>
                          <MIN>128</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                      </PARAMETERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                  </SUB-CONTAINERS>
                </ECUC-PARAM-CONF-CONTAINER-DEF>
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:3d20f88a-4502-4ed1-9062-037ed116b946">
                  <SHORT-NAME>OsMemoryProtection</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Container to structure all memory protection relevant configuration parameters.Memory protection is only allowed if OS scalability class is set to SC3 or SC4.</L-2>
                    <L-2 L="ZH">概述：OsMemoryProtection配置项用于定义操作系统的内存保护设置，确保系统内存区域的隔离和保护，防止未授权的访问和潜在的错误影响系统的稳定性。</L-2>
                    <L-2 L="ZH">注意：在配置OsMemoryProtection时，需要确保与硬件支持的内存保护机制相匹配；应考虑不同运行实体间的内存隔离需求；在多核系统中，还需注意核间的内存保护策略一致性。</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <MULTIPLICITY-CONFIG-CLASSES>
                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                  </MULTIPLICITY-CONFIG-CLASSES>
                  <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                  <REQUIRES-INDEX>false</REQUIRES-INDEX>
                  <SUB-CONTAINERS>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:3bfba0e2-7863-4d61-b550-6b4cbe759eb5">
                      <SHORT-NAME>OsMemoryRegion</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Container to structure the configuration parameters of one memory protection region.</L-2>
                        <L-2 L="ZH">概述：OsMemoryRegion配置项用于定义操作系统内存保护区域的属性，如地址界限、访问权限和内存属性等，确保内存区域的访问符合系统安全和性能要求。</L-2>
                        <L-2 L="ZH">注意：在配置OsMemoryRegion时，需要确保所选标志与处理器架构和操作系统的内存保护机制兼容。</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                      <MULTIPLICITY-CONFIG-CLASSES>
                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      </MULTIPLICITY-CONFIG-CLASSES>
                      <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                      <REQUIRES-INDEX>false</REQUIRES-INDEX>
                      <PARAMETERS>
                        <ECUC-STRING-PARAM-DEF UUID="ECUC:2210c2f7-18ae-461a-82e5-7a6ba7dd6595">
                          <SHORT-NAME>OsMemoryRegionStartAddress</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Start address of a memory protection region. The address can be specified either as a valid decimal (1024) or hexadecimal (0x4000) value, or as a valid linker symbol.StartAddress &lt;= Memory to be accessed</L-2>
                            <L-2 L="ZH">概述：OsMemoryRegionStartAddress 配置项用于定义操作系统内存区域的起始地址，这是为了确保操作系统组件能够访问正确的内存区域。</L-2>
                            <L-2 L="ZH">注意：在配置时必须确保地址与实际的硬件内存映射一致；避免与其他内存区域的地址重叠，以防止数据冲突和系统不稳定；在多核或多分区系统中，还需考虑内存隔离和保护机制。</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <MULTIPLICITY-CONFIG-CLASSES>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          </MULTIPLICITY-CONFIG-CLASSES>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <REQUIRES-INDEX>false</REQUIRES-INDEX>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                        </ECUC-STRING-PARAM-DEF>
                        <ECUC-STRING-PARAM-DEF UUID="ECUC:75de1556-476e-44b0-aa9f-caae48da2baa">
                          <SHORT-NAME>OsMemoryRegionEndAddress</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">End address of a memory protection region. The address can be specified either as a valid decimal (1024) or hexadecimal (0x4000) value, or as a valid linker symbol.Depending on the underlying hardware:Memory to be accessed &lt;= EndAddress or Memory to be accessed &lt; EndAddress</L-2>
                            <L-2 L="ZH">概述：OsMemoryRegionEndAddress 配置项指定了操作系统内存区域的结束地址，用于定义内存分区的边界，确保内存访问的安全性和合法性。</L-2>
                            <L-2 L="ZH">注意：在配置OsMemoryRegionEndAddress时，需要确保地址对齐并且不超出实际物理内存范围；此外，结束地址应该大于等于对应内存区域的起始地址；在AUTOSAR CP 4.4标准中，内存保护和分区管理是关键特性，因此正确配置内存区域地址是系统稳定性和安全性的重要因素。</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <MULTIPLICITY-CONFIG-CLASSES>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          </MULTIPLICITY-CONFIG-CLASSES>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <REQUIRES-INDEX>false</REQUIRES-INDEX>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                        </ECUC-STRING-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:dd29c315-7d29-4a2d-8e66-6c1c413f630c">
                          <SHORT-NAME>OsMemoryRegionIndex</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Defines the optional hardware specific memory protection region index.The interpretation of this parameter is hardware specific.</L-2>
                            <L-2 L="ZH">概述：OsMemoryRegionIndex配置项用于定义操作系统级别的内存保护区域的顺序。</L-2>
                            <L-2 L="ZH">注意：OsMemoryRegionIndex与硬件架构相关。</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <MULTIPLICITY-CONFIG-CLASSES>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          </MULTIPLICITY-CONFIG-CLASSES>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <REQUIRES-INDEX>false</REQUIRES-INDEX>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <MAX>32</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                      </PARAMETERS>
                      <REFERENCES>
                        <ECUC-CHOICE-REFERENCE-DEF UUID="ECUC:175a7e84-7c27-4291-9094-315a4987fff3">
                          <SHORT-NAME>OsMemoryRegionOwner</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Specifies whether a memory protection region is OS-Application, Task or ISR specific or Global.</L-2>
                            <L-2 L="ZH">概述：OsMemoryRegionOwner配置项用于定义内存保护设置所保护的范围，可以是Core级别的，也可以是App、Task或者ISR级别的。</L-2>
                            <L-2 L="ZH">注意：当没有设置OsMemoryRegionOwner时，默认为Core级别的内存保护设置。</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <MULTIPLICITY-CONFIG-CLASSES>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          </MULTIPLICITY-CONFIG-CLASSES>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <REQUIRES-INDEX>false</REQUIRES-INDEX>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DESTINATION-REFS>
                            <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Os/OsApplication</DESTINATION-REF>
                            <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Os/OsIsr</DESTINATION-REF>
                            <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Os/OsTask</DESTINATION-REF>
                          </DESTINATION-REFS>
                        </ECUC-CHOICE-REFERENCE-DEF>
                        <ECUC-CHOICE-REFERENCE-DEF UUID="ECUC:cfd72eb9-4240-4cdd-b1c0-fd5be7973fc1">
                          <SHORT-NAME>OsMemoryRegionProtectionUnit</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">References on which memory protection unit (core or system) the memory protection region shall be used.</L-2>
                            <L-2 L="ZH">概述：OsMemoryRegionProtectionUnit配置项用于定义内存保护设置所属核。</L-2>
                            <L-2 L="ZH">注意：OsMemoryRegionProtectionUnit需与硬件架构相适配。</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <MULTIPLICITY-CONFIG-CLASSES>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          </MULTIPLICITY-CONFIG-CLASSES>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <REQUIRES-INDEX>false</REQUIRES-INDEX>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DESTINATION-REFS>
                            <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Os/OsPublishedInformation/OsDerivativeInformation/OsPhysicalCore</DESTINATION-REF>
                          </DESTINATION-REFS>
                        </ECUC-CHOICE-REFERENCE-DEF>
                        <ECUC-REFERENCE-DEF UUID="ECUC:b23266fb-26bc-4747-a6e9-d7535d438072">
                          <SHORT-NAME>OsMemoryRegionAccessRights</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This reference is used to set access rights for the memory protection region.</L-2>
                            <L-2 L="ZH">概述：OsMemoryRegionAccessRights配置项用于定义内存保护区域的访问属性。</L-2>
                            <L-2 L="ZH">注意：AUTOSAR CP 4.4标准中对内存保护有严格的规范，需要确保配置符合标准的内存分区和访问权限要求；在多核系统中，还需考虑跨核访问的内存保护策略；配置错误可能导致系统启动失败或运行时异常。</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <MULTIPLICITY-CONFIG-CLASSES>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          </MULTIPLICITY-CONFIG-CLASSES>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <REQUIRES-INDEX>false</REQUIRES-INDEX>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Os/OsPublishedInformation/OsDerivativeInformation/OsMemoryRegionSpecifics/OsMemoryRegionAccess</DESTINATION-REF>
                        </ECUC-REFERENCE-DEF>
                        <ECUC-REFERENCE-DEF UUID="ECUC:4ff5b723-748a-44aa-afc8-8d2fb9c5b595">
                          <SHORT-NAME>OsMemoryRegionFlags</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Specific memory protection region flag. e.g. Cachable, Device, ...</L-2>
                            <L-2 L="ZH">概述：OsMemoryRegionAccessRights配置项用于定义内存保护区域的访问属性。</L-2>
                            <L-2 L="ZH">注意：OsMemoryRegionAccessRights配置时需参考硬件特性。</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <MULTIPLICITY-CONFIG-CLASSES>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          </MULTIPLICITY-CONFIG-CLASSES>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <REQUIRES-INDEX>false</REQUIRES-INDEX>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Os/OsPublishedInformation/OsDerivativeInformation/OsMemoryRegionSpecifics/OsMemoryRegionFlags</DESTINATION-REF>
                        </ECUC-REFERENCE-DEF>
                      </REFERENCES>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                  </SUB-CONTAINERS>
                </ECUC-PARAM-CONF-CONTAINER-DEF>
              </CONTAINERS>
            </ECUC-MODULE-DEF>
          </ELEMENTS>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>