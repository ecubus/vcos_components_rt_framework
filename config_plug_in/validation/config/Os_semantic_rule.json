    "OS014006": {
        "rule_name": "OS014006",
        "rule_type": "repeatability_check",
        "rule_summary": "Repeatablity check of OsAppTaskRef.",
        "rule_message": "An Task must belong to an Application.",
        "rule_ruleset": {
            "mod_path": "/AUTOSAR/EcucDefs/Os/OsApplication/OsAppTaskRef",
