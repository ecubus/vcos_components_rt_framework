        }
    },
    "OS014010": {
        "rule_name": "OS014010",
        "rule_type": "diff_container_linkage_check",
        "rule_summary": "The check of OsTaskStackSize.",
        "rule_message": "The value of OsTaskStackSize is greater than or equal to 128 and is an integer multiple of 4.",
        "rule_ruleset": {
            "ruleset_01": {
                "judgement": {
                    "mod_path": ["/AUTOSAR/EcucDefs/Os/OsTask/OsTaskStackSize"],
                    "judge_expression": "%0 % 4 == 0 and %0 >= 128"
                },
                "auto_solve_list": [{
                    "solve_info": "Set the value of /AUTOSAR/EcucDefs/Os/OsTask/OsTaskStackSize to minimum(value=128).",
                    "solve_type": "SetValue",
                    "parameter": "/AUTOSAR/EcucDefs/Os/OsTask/OsTaskStackSize",
                    "value": 128
                }]
            }
        }
    },
    "OS014011": {
        "rule_name": "OS014011",
        "rule_type": "diff_container_linkage_check",
        "rule_summary": "The check of OsTaskStackSize.",
        "rule_message": "The value of OsTaskStackSize must be greater than or equal to the configured min_osTaskStackSize.",
        "rule_ruleset": {
            "ruleset_01": {
                "judgement": {
                    "mod_path": ["/AUTOSAR/EcucDefs/Os/OsTask/OsTaskStackSize"],
                    "judge_expression": "bool(self.validation_data.sys_info_class.target) and %0 >= self.validation_data.sys_info_class.system_target_info.get('validate',{}).get('ignore_option',{}).get('Os',{}).get('min_OsTaskStackSize', 128)"
                }
            }
        }
    },
    "OS014017": {
        "rule_name": "OS014017",
        "rule_type": "repeatability_check",
        "rule_summary": "Repeatablity check of OsTaskEventRef.",
        "rule_message": "An OsTaskEventRef can be referenced by a task only once.",
        "rule_ruleset": {
            "mod_path": "/AUTOSAR/EcucDefs/Os/OsTask/OsTaskEventRef",
            "base_path": "/AUTOSAR/EcucDefs/Os"
        }
    },
    "OS013014": {
        "rule_name": "OS013014",
        "rule_type": "repeatability_check",
        "rule_summary": "Repeatablity check of OsAppEcucPartitionRef.",
        "rule_message": "The ecuc partition should only be referred by one OsApplication.",
        "rule_ruleset": {
            "mod_path": "/AUTOSAR/EcucDefs/Os/OsApplication/OsAppEcucPartitionRef",
            "base_path": "/AUTOSAR/EcucDefs/Os"
        }
    }
}
