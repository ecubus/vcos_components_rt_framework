{
    "OS012003": {
        "rule_name": "OS012003",
        "rule_type": "same_container_linkage_check",
        "rule_summary": "The linkage check of OsScheduleTableAutostartType and OsScheduleTableStartValue.",
        "rule_message": "If OsScheduleTableAutostartType is 'ABSOLUTE' or 'RELATIVE', OsScheduleTableStartValue must be configured.",
        "rule_ruleset": {
            "ruleset_01": {
                "base_path": "/AUTOSAR/EcucDefs/Os/OsScheduleTable/OsScheduleTableAutostart",
                "condition": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Os/OsScheduleTable/OsScheduleTableAutostart/OsScheduleTableAutostartType",
                        "value_operator": "==",
                        "value": "ABSOLUTE",
                        "logical_operator": "or"
                    },
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Os/OsScheduleTable/OsScheduleTableAutostart/OsScheduleTableAutostartType",
                        "value_operator": "==",
                        "value": "RELATIVE",
                        "logical_operator": "or"
                    }
                ],
                "judgement": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Os/OsScheduleTable/OsScheduleTableAutostart/OsScheduleTableStartValue",
                        "value_operator": "!=",
                        "value": "",
                        "logical_operator": "and"
                    },
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Os/OsScheduleTable/OsScheduleTableAutostart/OsScheduleTableStartValue",
                        "value_operator": "!=",
                        "value": null,
                        "logical_operator": "and"
                    },
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Os/OsScheduleTable/OsScheduleTableAutostart/OsScheduleTableStartValue",
                        "value_operator": "!=",
                        "value": "<empty>",
                        "logical_operator": "and"
                    }
                ]
            }
        }
    },
    "OS013003": {
        "rule_name": "OS013003",
        "rule_type": "same_container_linkage_check",
        "rule_summary": "The linkage check of OsIsPrivileged, OsTrusted and OsTrustedApplicationWithProtection.",
        "rule_message": "If OsTrusted is true and OsTrustedApplicationWithProtection is false, OsIsPrivileged must be true; If OsTrusted is true and  OsTrustedApplicationWithProtection is true, OsIsPrivileged must be false; If OsTrusted is false,OsIsPrivileged must be false.",
        "rule_ruleset": {
            "ruleset_01": {
                "base_path": "/AUTOSAR/EcucDefs/Os/OsApplication",
                "condition": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Os/OsApplication/OsTrusted",
                        "value_operator": "==",
                        "value": true,
                        "logical_operator": "and"
                    },
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Os/OsApplication/OsTrustedApplicationWithProtection",
                        "value_operator": "==",
                        "value": false,
                        "logical_operator": "and"
                    }
                ],
                "judgement": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Os/OsApplication/OsIsPrivileged",
                        "value_operator": "==",
                        "value": true,
                        "logical_operator": "and"
                    }
                ]
            },
            "ruleset_02": {
                "base_path": "/AUTOSAR/EcucDefs/Os/OsApplication",
                "condition": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Os/OsApplication/OsTrusted",
                        "value_operator": "==",
                        "value": true,
                        "logical_operator": "and"
                    },
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Os/OsApplication/OsTrustedApplicationWithProtection",
                        "value_operator": "==",
                        "value": true,
                        "logical_operator": "and"
                    }
                ],
                "judgement": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Os/OsApplication/OsIsPrivileged",
                        "value_operator": "==",
                        "value": false,
                        "logical_operator": "and"
                    }
                ]
            },
            "ruleset_03": {
                "base_path": "/AUTOSAR/EcucDefs/Os/OsApplication",
                "condition": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Os/OsApplication/OsTrusted",
                        "value_operator": "==",
                        "value": false,
                        "logical_operator": "and"
                    }
                ],
                "judgement": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Os/OsApplication/OsIsPrivileged",
                        "value_operator": "==",
                        "value": false,
                        "logical_operator": "and"
                    }
                ]
            }
        }
    },
    "OS013004": {
        "rule_name": "OS013004",
        "rule_type": "same_container_linkage_check",
        "rule_summary": "The linkage check of OsTaskType and OsTaskActivation.",
        "rule_message": "If OsTaskActivation is greater than 1, OsTaskType must be 'BASIC'.",
        "rule_ruleset": {
            "ruleset_01": {
                "base_path": "/AUTOSAR/EcucDefs/Os/OsTask",
                "condition": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Os/OsTask/OsTaskActivation",
                        "value_operator": ">",
                        "value": 1,
                        "logical_operator": "and"
                    }
                ],
                "judgement": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Os/OsTask/OsTaskType",
                        "value_operator": "==",
                        "value": "BASIC",
                        "logical_operator": "and"
                    }
                ]
            }
        }
    },
    "OS013010": {
        "rule_name": "OS013010",
        "rule_type": "repeatability_check",
        "rule_summary": "Repeatablity check of OsScheduleTblExpPointOffset.",
        "rule_message": "/AUTOSAR/EcucDefs/Os/OsScheduleTable/OsScheduleTableExpiryPoint/OsScheduleTblExpPointOffset should be unique in one OsScheduleTableExpiryPoint.",
        "rule_ruleset": {
            "mod_path": "/AUTOSAR/EcucDefs/Os/OsScheduleTable/OsScheduleTableExpiryPoint/OsScheduleTblExpPointOffset",
            "base_path": "/AUTOSAR/EcucDefs/Os/OsScheduleTable"
        },
        "auto_solve_list": [],
        "manual_solve_list": []
    },
    "OS013012": {
        "rule_name": "OS013012",
        "rule_type": "same_container_linkage_check",
        "rule_summary": "The linkage check of OsIsrTimingProtection.",
        "rule_message": "OsIsrTimingProtection is not available for CATEGORY_1 ISR.",
        "rule_ruleset": {
            "ruleset_01": {
                "base_path": "/AUTOSAR/EcucDefs/Os/OsIsr",
                "condition": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Os/OsIsr/OsIsrTimingProtection",
                        "value_operator": "!=",
                        "value": null,
                        "logical_operator": "and"
                    }
                ],
                "judgement": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Os/OsIsr/OsIsrCategory",
                        "value_operator": "!=",
                        "value": "CATEGORY_1",
                        "logical_operator": "and"
                    }
                ]
            }
        }
    },
    "OS014003": {
