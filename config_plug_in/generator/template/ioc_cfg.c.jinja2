static void IocRefSend_{{ioc_name}}_Cbk (void * buffer, uint8 idx, void const * data)
{
    {{dataType}} * databuffer = ({{dataType}} *)buffer;
    {{dataType}} * value = ({{dataType}} *)data;
    {%- if baseDataType in ["uint64", "sint64", "float64"]:%}
    databuffer[idx] = *value;
    {%- else:%}
    (void)memcpy(&(databuffer[idx]), value, sizeof({{dataType}}));
    {%- endif %}
}
